# ==============================================================================
# Waypoint Logistics - Backend Environment Template (FastAPI)
# ==============================================================================

# Application Settings
PROJECT_NAME="Waypoint Logistics API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT=development
DEBUG=true
PORT=5000
BACKEND_PORT=5000

# PostgreSQL Database Configuration (Neon or local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=waypoint_logistics
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/waypoint_logistics

# Migrations only (optional direct connection for serverless/pooled databases like Neon)
DATABASE_URL_UNPOOLED=


# Keycloak Authentication & Authorization
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=waypointlogistics
KEYCLOAK_CLIENT_ID=waypoint-backend
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here
KEYCLOAK_ALGORITHM=RS256
KEYCLOAK_AUDIENCE=account
KEYCLOAK_DEV_MODE=true

# Temporary dispatcher scope until authenticated Keycloak depot claims are enabled.
DISPATCHER_DEFAULT_DEPOT=peliyagoda

# Backend allocation policy (route legs and weekly fuel balances must be recorded)
ALLOCATION_MAX_TRIPS_PER_DAY=2
SERVICE_ALLOWANCE_CSV="app/reference_data/service_allowance.csv"
DISTRICT_TRAVEL_CSV="app/reference_data/district_travel.csv"

# One system sender for operational email. Recipients come from assigned user
# accounts and outlet contacts; roles do not need SMTP credentials.
# Run python -m app.email.worker after migrating and enabling email.
EMAIL_ENABLED=false
EMAIL_FROM=dispatch@example.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
EMAIL_SMTP_SSL=false
EMAIL_WORKER_BATCH_SIZE=25
# Existing Gmail credentials can also be supplied as EMAIL_USER and EMAIL_APP_PASSWORD.
# With a Gmail address, the email module defaults to smtp.gmail.com:587 STARTTLS.

# Security / Fallback JWT Secret (HS256)
SECRET_KEY=change-this-in-production-super-secret-key-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# CORS Allowed Origins (JSON array of strings)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

EMAIL_USER=waypointlogistics.noreply@gmail.com
EMAIL_APP_PASSWORD=pkgp vezc ston xqdu

# Cloudflare R2 for driver photos (optional: without these, photos stay in backend/app/static/uploads)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
