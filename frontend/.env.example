# ==============================================================================
# Waypoint Logistics - Frontend Environment Template (Next.js)
# ==============================================================================

# Backend API base URL (accessible from the browser via NEXT_PUBLIC_, defaults to 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application Environment & Name
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME="Waypoint Logistics"

# Next.js Server Port (Default: 3000)
PORT=3000

# Optional Keycloak SSO (Client Side)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=waypointlogistics
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=waypoint-frontend

# Store Manager data: "mock" (default) or "api" (uses NEXT_PUBLIC_API_URL).
# Keep "mock" until the Store Manager migration is applied to the shared database.
NEXT_PUBLIC_STORE_DATA_SOURCE=mock
# Outlet the Store Manager screens act for, until Keycloak provides it from the login.
NEXT_PUBLIC_STORE_OUTLET_ID=1

# Loader tablet: unset = built-in mock data; "api" = the real /api/v1/loader endpoints at NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_LOADER_TRANSPORT=api
